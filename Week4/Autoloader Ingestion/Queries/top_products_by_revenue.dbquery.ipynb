   "source": [
    "SELECT\n",
    "    product_name,\n",
    "    ROUND(SUM(line_total), 2) AS revenue\n",
    "FROM practice_ecommerce.silver.order_lines_enriched\n",
    "WHERE order_status = 'completed'\n",
    "GROUP BY product_name\n",
    "ORDER BY revenue DESC\n",
    "LIMIT 5;"
   ]
